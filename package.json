{
  "name": "dsh-deepseek-quota-bar",
  "version": "0.7.0",
  "description": "DeepSeek API quota widget for the dsh web GUI: floating bottom-right card with a blood-bar of remaining balance vs month-opening balance, plus today/month spend, peak/off-peak reminder and current conversation cost (fork of dsh-deepseek-quota).",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.6 <0.2.0",
      "dshReleases": {
        "0.1.0-rc.6": "compatible",
        "0.1.5-alpha.1": "unknown",
        "0.1.5-alpha.2": "unknown",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      },
      "node": "^22.19.0 || >=24.0.0",
      "systems": [],
      "profiles": [
        "web"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "quota",
    "balance",
    "usage",
    "cost",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiangli07/dsh-deepseek-quota-bar.git"
  },
  "bugs": {
    "url": "https://github.com/jiangli07/dsh-deepseek-quota-bar/issues"
  },
  "homepage": "https://github.com/jiangli07/dsh-deepseek-quota-bar#readme"
}
